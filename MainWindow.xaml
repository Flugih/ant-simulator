<Window x:Class="ant_simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ant_simulator"
        mc:Ignorable="d"
        Title="ant-simulator" Height="700" Width="1000" MinHeight="560" MinWidth="700" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Margin="0,0,10,0">
            <Border BorderBrush="Black" BorderThickness="1">
                <UniformGrid x:Name="gridField"/>
            </Border>
        </Viewbox>

        <StackPanel Grid.Column="1">
            <GroupBox Header="Игровое поле">
                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Ширина (клеток):" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="textBoxWidth" Text="80" Width="90"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Высота (клеток):" Width="130" VerticalAlignment="Center"/>
                        <TextBox x:Name="textBoxHeight" Text="80" Width="90"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Правила муравья" Margin="0,10,0,0">
                <StackPanel Margin="5">
                    <TextBlock Text="Если клетка БЕЛАЯ:" Margin="0,5,0,0"/>
                    <ComboBox x:Name="comboBoxWhite" SelectedIndex="0" Margin="0,5,0,0">
                        <ComboBoxItem Content="Повернуть направо"/>
                        <ComboBoxItem Content="Повернуть налево"/>
                        <ComboBoxItem Content="Идти прямо"/>
                    </ComboBox>
                    <CheckBox x:Name="checkBoxWhiteRecolor" Content="Перекрасить клетку" IsChecked="True" Margin="0,5,0,0"/>

                    <TextBlock Text="Если клетка ЧЁРНАЯ:" Margin="0,15,0,0"/>
                    <ComboBox x:Name="comboBoxBlack" SelectedIndex="1" Margin="0,5,0,0">
                        <ComboBoxItem Content="Повернуть направо"/>
                        <ComboBoxItem Content="Повернуть налево"/>
                        <ComboBoxItem Content="Идти прямо"/>
                    </ComboBox>
                    <CheckBox x:Name="checkBoxBlackRecolor" Content="Перекрасить клетку" IsChecked="True" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Управление" Margin="0,10,0,0">
                <StackPanel Margin="5">
                    <Button x:Name="buttonGenerate" Content="Сгенерировать" Height="30" Margin="0,5,0,0" Click="buttonGenerate_Click"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="buttonStart" Grid.Column="0" Content="Запустить" Height="30" Margin="0,0,3,0" Click="buttonStart_Click"/>
                        <Button x:Name="buttonPause" Grid.Column="1" Content="Пауза" Height="30" Margin="3,0,0,0" Click="buttonPause_Click"/>
                    </Grid>
                    <TextBlock x:Name="textBlockSteps" Text="Шагов: 0" Margin="0,10,0,5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>
